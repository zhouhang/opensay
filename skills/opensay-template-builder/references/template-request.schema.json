{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensay.local/template-request-v1.json",
  "title": "OpenSay template creation or extension request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "mode", "library_root", "target_template"],
  "properties": {
    "schema": {"const": "opensay-template-request-v1"},
    "request_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["create-template", "extend-template"]},
    "library_root": {"type": "string", "minLength": 1},
    "target_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "template_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "capability_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "location"],
        "properties": {
          "kind": {"enum": ["file", "url"]},
          "location": {"type": "string", "minLength": 1},
          "focus": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "episode_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shot_id", "kind", "reason", "desired_expression"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["routing", "material", "timing", "module", "repetition"]},
          "reason": {"type": "string", "minLength": 1},
          "desired_expression": {"type": "string", "minLength": 1}
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "presenter_modes": {"type": "array", "items": {"enum": ["none", "video", "image"]}}
      }
    },
    "scope_notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "create-template"}}},
      "then": {"required": ["references"], "properties": {"references": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"mode": {"const": "extend-template"}}},
      "then": {
        "required": ["episode_plan", "issues"],
        "properties": {
          "target_template": {"required": ["template_id", "version", "capability_sha256"]},
          "issues": {"minItems": 1}
        }
      }
    }
  ]
}
