{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensay.local/sticker/template-capability-v1.json",
  "type": "object",
  "required": ["schema", "template_id", "version", "runtime", "production_modes", "modules"],
  "properties": {
    "schema": { "const": "opensay-template-capability-v1" },
    "template_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "production_modes": { "type": "object", "additionalProperties": { "type": "string" } },
    "style_tokens": { "type": "array", "items": { "type": "string" } },
    "media_roles": { "type": "array", "items": { "type": "string" } },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "semantic_intents", "duration", "asset_slots",
          "presenter_modes", "continuous_voice", "beat_input",
          "layout_signature", "motion_signature", "renderer_entry"
        ],
        "properties": {
          "id": { "type": "string" },
          "semantic_intents": { "type": "array", "items": { "type": "string" } },
          "duration": {
            "type": "object",
            "required": ["min", "ideal", "max"],
            "properties": {
              "min": { "type": "number", "minimum": 0 },
              "ideal": { "type": "number", "minimum": 0 },
              "max": { "type": "number", "minimum": 0 }
            }
          },
          "asset_slots": {
            "type": "array",
            "items": { "enum": ["text", "logo", "image", "screenshot", "video", "presenter_video", "presenter_image", "audio"] }
          },
          "presenter_modes": { "type": "array", "items": { "enum": ["none", "file", "image", "video"] } },
          "continuous_voice": { "type": "boolean" },
          "beat_input": { "enum": ["sentence", "sentence_or_optional_word", "word_preferred"] },
          "word_timing_required": { "type": "boolean" },
          "layout_signature": { "type": "string", "minLength": 1 },
          "motion_signature": { "type": "string", "minLength": 1 },
          "renderer_entry": { "type": "string", "minLength": 1 },
          "golden_preview": { "type": ["string", "null"] },
          "status": { "type": "string" }
        }
      }
    },
    "route_policy": { "type": "object" }
  }
}
